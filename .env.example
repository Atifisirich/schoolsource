# Copy to .env.local and fill in.

# Web3Forms access key for info@schoolsource.in (https://web3forms.com).
# Without it, forms show a WhatsApp / email fallback instead of sending.
NEXT_PUBLIC_WEB3FORMS_KEY=

# File attachments need a paid Web3Forms plan. Set to true once enabled;
# otherwise people are asked to send their list photo on WhatsApp instead.
NEXT_PUBLIC_WEB3FORMS_FILE_UPLOAD=false

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to keep analytics off.
NEXT_PUBLIC_GA_ID=
